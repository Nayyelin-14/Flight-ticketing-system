DATABASE_URL='postgresql://user:password@host:5432/dbname'

APP_URL=http://localhost:8000

SMTP_HOST=your-smtp-host.example.com
SMTP_PORT=587
SMTP_USERNAME=smtp-user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_STARTTLS=true

EMAIL_BACKEND=smtp
EMAIL_ALLOW_NOOP_ACK=false
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_DELAY=2
EMAIL_MAX_RETRY_DELAY=300
EMAIL_MAX_CONCURRENCY=4
EMAIL_BATCH_SIZE=100
EMAIL_POLL_INTERVAL=5.0
EMAIL_PROCESSING_TIMEOUT=120

# Kafka (enable to use the Kafka publisher/consumer instead of the polling worker).
# Standard Kafka-compatible config; works with Confluent Cloud, Apache Kafka, or
# any compatible broker. Credentials come only from environment variables.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=your-api-key
KAFKA_SASL_PASSWORD=your-api-secret
KAFKA_CONSUMER_GROUP=notification-workers
KAFKA_SOURCE=flight-api
# Provision domain topics (+ -retry/-dlq companions) idempotently at worker startup.
# Disable when infrastructure/Terraform manages Kafka (topic-creation ACLs not granted to app keys).
KAFKA_PROVISION_TOPICS=true
# New-topic sizing; standard Confluent Cloud clusters require replication factor 3.
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION=1